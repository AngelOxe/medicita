meta {
  name: 05 - Cerrar sesion
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Logout correcto", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Sesion cerrada correctamente");
  });
}