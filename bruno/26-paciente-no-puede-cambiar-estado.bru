meta {
  name: 26 - Paciente no puede cambiar estado
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/api/citas/{{citaId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenPaciente}}
}

body:json {
  { "estado": "completada" }
}

tests {
  test("Solo el medico cambia el estado: el paciente recibe 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
