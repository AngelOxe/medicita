meta {
  name: 18 - Editar servicio
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/api/servicios/{{servicioQaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenAdmin}}
}

body:json {
  { "nombre": "Servicio Bruno editado", "descripcion": "x", "duracionMin": 30, "precio": 150, "activo": false }
}

tests {
  test("Edita el servicio", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().activo).to.equal(false);
  });
}
