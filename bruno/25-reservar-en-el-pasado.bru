meta {
  name: 25 - Reservar en el pasado
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/citas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenPaciente}}
}

body:json {
  { "servicioId": {{servicioId}}, "inicio": "2020-01-01T10:00:00-06:00" }
}

tests {
  test("Una fecha pasada devuelve 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
}
