meta {
  name: 07 - Login administrador
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{adminEmail}}", "password": "{{adminPassword}}" }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("tokenAdmin", res.getBody().token);
  }
}

tests {
  test("El administrador inicia sesion", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().usuario.rol).to.equal("ADMIN");
  });
}
