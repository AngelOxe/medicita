spring.application.name=medicita
server.port=8085

# Copiar este archivo como application.properties y completar los datos locales
spring.datasource.url=jdbc:postgresql://localhost:5432/medicita
spring.datasource.username=CAMBIAR
spring.datasource.password=CAMBIAR

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.flyway.enabled=true

# Generar 32 bytes aleatorios y codificarlos en Base64
app.jwt.secret=CAMBIAR_POR_CLAVE_BASE64
app.jwt.expiration-minutes=60
app.jwt.issuer=medicita

# Zona horaria unica del consultorio
app.timezone=America/Mexico_City

# URL del frontend (se usa en el enlace de recuperar contrasena)
app.frontend-url=http://localhost:5173

# Iniciar sesion con Google: ID de cliente OAuth (tipo "Aplicacion web") de Google Cloud Console.
# Es un dato PUBLICO, no un secreto. Si se deja vacio, el boton de Google se oculta y la ruta no esta disponible.
app.google.client-id=
# Correo: Postfix local del servidor. En desarrollo se deja app.mail.enabled=false (solo escribe en el log)
app.mail.enabled=false
app.mail.from=no-reply@tu-dominio.com
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.connectiontimeout=3000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# WhatsApp con la API oficial de Meta (WhatsApp Cloud API) y una plantilla PROPIA aprobada en el panel de Meta.
# Si esta apagado o sin token, el WhatsApp sale por Twilio (ver abajo). El token NUNCA se sube al repositorio.
app.whatsapp.enabled=false
app.whatsapp.phone-number-id=CAMBIAR
app.whatsapp.token=CAMBIAR
# Plantilla de confirmacion con 3 variables: {{1}} paciente, {{2}} servicio, {{3}} fecha y hora
app.whatsapp.template-confirmada=cita_confirmada
# Plantilla de cancelacion (opcional, mismas 3 variables). Vacia = no se envia WhatsApp al cancelar
app.whatsapp.template-cancelada=
app.whatsapp.language=es_MX
# SMS y WhatsApp con Twilio. En desarrollo se deja app.twilio.enabled=false (solo escribe en el log)
app.twilio.enabled=false
app.twilio.account-sid=CAMBIAR
app.twilio.auth-token=CAMBIAR
app.twilio.sms-from=+10000000000
# Cuenta de prueba: plantilla de SMS y ContentSid de WhatsApp (vacios si la cuenta acepta texto libre)
app.twilio.sms-template=sms_appointment_reminders
app.twilio.whatsapp-from=whatsapp:+10000000000
app.twilio.whatsapp-content-sid=CAMBIAR
