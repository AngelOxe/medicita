spring.application.name=medicita
server.port=8085

# Copiar este archivo como application.properties y completar los datos locales
spring.datasource.url=jdbc:postgresql://localhost:5432/medicita
spring.datasource.username=CAMBIAR
spring.datasource.password=CAMBIAR

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.flyway.enabled=true

# Generar 32 bytes aleatorios y codificarlos en Base64
app.jwt.secret=CAMBIAR_POR_CLAVE_BASE64
app.jwt.expiration-minutes=60
app.jwt.issuer=medicita

# Zona horaria unica del consultorio
app.timezone=America/Mexico_City

# URL del frontend (se usa en el enlace de recuperar contrasena)
app.frontend-url=http://localhost:5173

# Correo: Postfix local del servidor. En desarrollo se deja app.mail.enabled=false (solo escribe en el log)
app.mail.enabled=false
app.mail.from=no-reply@tu-dominio.com
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.connectiontimeout=3000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
